#!/usr/bin/env bash
# ohos-sdd — OpenHarmony SDD 机器层 CLI(shell 入口 + python 引擎调度)
set -euo pipefail

CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="${CLI_DIR}/ohos_sdd_engine.py"

# Resolve a Python 3.8+ interpreter once (python3 → python → py -3).
# Exported as OHOS_SDD_PYTHON so child processes (run_engine) reuse it.
# Keep in sync with packaging/lib/platform-env.sh::detect_python (CLI is a
# runtime dispatch artifact and cannot source the build-time lib).
_resolve_python() {
  [ -n "${OHOS_SDD_PYTHON:-}" ] && return 0
  local cand first
  for cand in python3 python "py -3"; do
    first="${cand%% *}"
    command -v "$first" >/dev/null 2>&1 || continue
    if $cand -c 'import sys;sys.exit(0 if sys.version_info>=(3,8) else 1)' 2>/dev/null; then
      OHOS_SDD_PYTHON="$cand"; return 0
    fi
  done
  return 1
}

resolve_contract() {
  local d="${CLI_DIR}"
  while [[ "$d" != "/" ]]; do
    for cand in "$d/runtime/assets/contracts/artifacts.yaml" "$d/contracts/artifacts.yaml"; do
      [[ -f "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
    done
    d="$(cd "$d/.." && pwd)"
  done
  for cand in "${CLI_DIR}/../contracts/artifacts.yaml" \
             "${CLI_DIR}/../shared/ohos-sdd/contracts/artifacts.yaml"; do
    [[ -f "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

resolve_templates() {
  local d="${CLI_DIR}"
  while [[ "$d" != "/" ]]; do
    for cand in "$d/runtime/assets/templates" "$d/templates"; do
      [[ -d "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
    done
    d="$(cd "$d/.." && pwd)"
  done
  for cand in "${CLI_DIR}/../templates" \
             "${CLI_DIR}/../shared/ohos-sdd/templates"; do
    [[ -d "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

resolve_profiles() {
  local d="${CLI_DIR}"
  while [[ "$d" != "/" ]]; do
    for cand in "$d/runtime/assets/profiles" "$d/profiles"; do
      [[ -d "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
    done
    d="$(cd "$d/.." && pwd)"
  done
  for cand in "${CLI_DIR}/../profiles" \
             "${CLI_DIR}/../shared/ohos-sdd/profiles"; do
    [[ -d "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

have_python() {
  [[ "${OHOS_SDD_NO_PYTHON:-0}" == "1" ]] && return 1   # 可测钩子
  _resolve_python
}

warn_no_python() {
  echo "[ohos-sdd] 深度校验需 Python 3.8+;无 Python 时仅显式 --level A 可执行 shell fallback。" >&2
  echo "  (tried python3, python, 'py -3'; install from python.org on Windows)" >&2
}

run_engine() {
  # shellcheck disable=SC2086  # OHOS_SDD_PYTHON may be multi-word ("py -3")
  $OHOS_SDD_PYTHON "${ENGINE}" "$@"
}

usage() {
  cat <<'EOF'
ohos-sdd — OpenHarmony SDD 机器层 CLI

用法:
  ohos-sdd status [<change>]
  ohos-sdd validate [<change>] [--level A|B|C|D|E|all] [--json]
  ohos-sdd approval-digest <change>
  ohos-sdd archive <change>
  ohos-sdd init <id>
  ohos-sdd registry
  ohos-sdd spec-for-validation <generate|refresh|check> <change>
  ohos-sdd version

Level:A/B 结构 / C 依赖一致-可追溯 / D 归档就绪 / E profile 门禁;validate 默认 all。
EOF
}

_validate_shell_fallback() {
  # 无 python 时的结构兜底:只做 Level A 核心(required 交付件存在性)。
  local change="$1"
  if [[ -z "$change" ]]; then echo "validate: 需要 <change-dir>" >&2; return 2; fi
  [[ -d "$change" ]] || { echo "validate: change dir not found: $change" >&2; return 2; }
  # 最小交付合同固定为四件套；简单变更通过内容简写裁剪。
  local required=(proposal.md spec.md design.md execution-plan.md)
  local broken=0 f
  echo "[FALLBACK] 结构校验(无 python,仅 Level A required 存在性)"
  for f in "${required[@]}"; do
    if [[ -f "${change}/${f}" ]]; then echo "[OK]   ${f}"
    else echo "[MISS] ${f} (required)"; broken=$((broken+1)); fi
  done
  echo "fallback: required-missing=${broken}"
  [[ "$broken" -eq 0 ]]
}

valid_change_id() {
  local id="$1"
  [[ "$id" =~ ^issue-[0-9]+-[a-z0-9][a-z0-9-]*$ ||
     "$id" =~ ^draft-[0-9]{8}-[a-z0-9][a-z0-9-]*$ ]]
}

workspace_change_root() {
  printf '%s/.codespec/changes\n' "$(pwd -P)"
}

resolve_archive_change() {
  local requested="$1"
  [[ -d "$requested" ]] || { echo "archive: change 目录不存在: $requested" >&2; return 2; }
  [[ ! -L "$requested" ]] || { echo "archive: 拒绝 symlink change 目录: $requested" >&2; return 2; }

  local root canonical id
  root="$(workspace_change_root)"
  [[ -d "$root" ]] || { echo "archive: 当前工作区缺少 .codespec/changes" >&2; return 2; }
  root="$(cd "$root" && pwd -P)"
  canonical="$(cd "$requested" && pwd -P)"
  [[ "$(dirname "$canonical")" == "$root" ]] || {
    echo "archive: change 必须是当前工作区 .codespec/changes 的直接子目录: $requested" >&2
    return 2
  }
  id="$(basename "$canonical")"
  valid_change_id "$id" || { echo "archive: 非法 change id: $id" >&2; return 2; }
  printf '%s\n' "$canonical"
}

cmd_status() {
  local change="${1:-}"
  if [[ -z "$change" ]]; then
    echo "usage: ohos-sdd status <change-dir>" >&2; exit 2
  fi
  if [[ ! -d "$change" ]]; then
    echo "status: change dir not found: $change" >&2; exit 2
  fi
  if have_python; then
    if ! run_engine legacy-check "$change"; then
      return 1
    fi
  else
    echo "[ohos-sdd] status 未执行 legacy 迁移检查：需要 Python 3.8+" >&2
  fi

  local rows=(
    "proposal|proposal.md|required"
    "spec|spec.md|required"
    "design|design.md|required"
    "execution-plan|execution-plan.md|required"
    "review|review.md|reference"
    "manifest|manifest.md|recommended"
    "test-spec|test-spec.md|conditional"
    "spec-for-validation|spec-for-validation.md|conditional-profile"
  )

  local present=0 missing=0 missing_required=0
  echo "change: ${change}"
  echo "--- deliverables ---"
  for row in "${rows[@]}"; do
    local rest="${row#*|}"
    local file="${rest%%|*}"
    local status="${rest##*|}"
    local id="${row%%|*}"
    if [[ -f "${change}/${file}" ]]; then
      echo "[OK]   ${id}  ${file}"; present=$((present+1))
    else
      echo "[MISS] ${id}  ${file}  (${status})"
      missing=$((missing+1))
      [[ "$status" == "required" ]] && missing_required=$((missing_required+1))
    fi
  done

  echo "--- dependency gaps ---"
  local gaps=0
  if [[ -f "${change}/spec.md" && ! -f "${change}/proposal.md" ]]; then echo "[GAP] spec 存在但缺 proposal"; gaps=$((gaps+1)); fi
  if [[ -f "${change}/design.md" && ! -f "${change}/spec.md" ]]; then echo "[GAP] design 存在但缺 spec"; gaps=$((gaps+1)); fi
  if [[ -f "${change}/execution-plan.md" && ! -f "${change}/design.md" ]]; then echo "[GAP] execution-plan 存在但缺 design"; gaps=$((gaps+1)); fi
  if [[ -f "${change}/spec-for-validation.md" && ! -f "${change}/design.md" ]]; then echo "[GAP] spec-for-validation 存在但缺 design"; gaps=$((gaps+1)); fi

  echo "--- summary ---"
  echo "present=${present} missing=${missing} (required-missing=${missing_required}) gaps=${gaps}"
  [[ "$missing_required" -eq 0 ]]
}
cmd_validate() {
  local original=("$@")
  local has_source=0 has_c=0 wants_json=0 change="" level="all" level_explicit=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source)
        [[ $has_source -eq 0 ]] || { echo "validate: --source 不得重复" >&2; return 2; }
        has_source=1
        ;;
      --contract)
        [[ $# -ge 2 && "$2" != --* ]] || { echo "validate: --contract 缺少路径" >&2; return 2; }
        has_c=1
        shift
        ;;
      --level)
        [[ $# -ge 2 && "$2" != --* ]] || { echo "validate: --level 缺少值" >&2; return 2; }
        [[ $level_explicit -eq 0 ]] || { echo "validate: --level 不得重复" >&2; return 2; }
        level="$2"
        level_explicit=1
        shift
        ;;
      --json)
        [[ $wants_json -eq 0 ]] || { echo "validate: --json 不得重复" >&2; return 2; }
        wants_json=1
        ;;
      -*)
        echo "validate: 未知参数 $1" >&2
        return 2
        ;;
      *)
        [[ -z "$change" ]] || { echo "validate: 只能指定一个 change/source 目录" >&2; return 2; }
        change="$1"
        ;;
    esac
    shift
  done

  if [[ $has_source -eq 1 ]]; then
    if [[ $level_explicit -eq 1 && "$level" != "contract" ]]; then
      echo "validate --source: --level 仅允许 contract" >&2
      return 2
    fi
  else
    case "$level" in
      A|B|C|D|E|all) ;;
      *) echo "validate: 未知 level '$level',允许 A/B/C/D/E/all" >&2; return 2 ;;
    esac
  fi

  if ! have_python; then
    if [[ $has_source -eq 1 ]]; then
      echo "validate --source 需 Python 3.8+" >&2; return 2
    fi
    if [[ $has_c -eq 1 || $wants_json -eq 1 ]]; then
      echo "validate: 无 Python 时无法执行 --contract/--json" >&2; return 2
    fi
    if [[ $level_explicit -ne 1 || "$level" != "A" ]]; then
      echo "validate: 无 Python 时仅允许显式 --level A；请求级别 '$level' 未执行" >&2
      return 2
    fi
    warn_no_python
    _validate_shell_fallback "${change:-$(pwd -P)}"
    return
  fi
  if [[ $has_source -eq 1 ]]; then
    run_engine validate "${original[@]}"
    return
  fi
  local contract
  contract="$(resolve_contract)" || { echo "validate: 找不到 artifacts.yaml 契约" >&2; return 2; }
  local args=("${original[@]}")
  [[ $has_c -eq 0 ]] && args=(--contract "$contract" "${original[@]}")
  run_engine validate "${args[@]}"
}
cmd_init() {
  local id="${1:-}"
  [[ -n "$id" ]] || { echo "usage: ohos-sdd init <change-id>" >&2; return 2; }
  valid_change_id "$id" || { echo "init: 非法 change id: $id" >&2; return 2; }
  local tmpl_dir
  tmpl_dir="$(resolve_templates)" || { echo "init: 找不到模板目录" >&2; return 2; }
  local root target
  root="$(workspace_change_root)"
  mkdir -p "$root" || { echo "init: 无法创建 $root" >&2; return 2; }
  root="$(cd "$root" && pwd -P)"
  target="${root}/${id}"
  [[ ! -e "$target" ]] || { echo "init: change 已存在: $target" >&2; return 2; }
  mkdir -p "$target" || { echo "init: 无法创建 $target" >&2; return 2; }
  local f
  for f in proposal.md spec.md design.md execution-plan.md; do
    [[ -f "${tmpl_dir}/${f}" ]] && cp "${tmpl_dir}/${f}" "${target}/${f}"
  done
  echo "已脚手架:.codespec/changes/${id}(proposal/spec/design/execution-plan 核心四件套)"
}

cmd_registry() {
  local reg=".codespec/registry.md"
  if [[ -f "$reg" ]]; then cat "$reg"; return 0; fi
  echo "(无 ${reg})"
  return 1
}

cmd_approval_digest() {
  [[ $# -eq 1 ]] || { echo "usage: ohos-sdd approval-digest <change-dir>" >&2; return 2; }
  local change="$1"
  [[ -d "$change" ]] || { echo "approval-digest: change dir not found: $change" >&2; return 2; }
  have_python || { echo "approval-digest 需 Python 3.8+" >&2; return 2; }
  run_engine approval-digest "$change"
}

cmd_archive() {
  local requested="${1:-}" change
  [[ -n "$requested" ]] || { echo "usage: ohos-sdd archive <change-dir>" >&2; return 2; }
  change="$(resolve_archive_change "$requested")" || return $?
  have_python || { echo "archive: 归档就绪硬门禁需要 Python 3.8+，拒绝归档" >&2; return 2; }
  local contract
  contract="$(resolve_contract)" || { echo "archive: 找不到 artifacts.yaml 契约" >&2; return 2; }
  local workspace_root reg first_line=""
  workspace_root="$(pwd -P)"
  reg="${workspace_root}/.codespec/registry.md"
  if [[ -e "$reg" ]]; then
    [[ -f "$reg" && ! -L "$reg" ]] || { echo "archive: registry 必须是普通文件: $reg" >&2; return 2; }
    IFS= read -r first_line <"$reg" || true
    [[ "$first_line" == "# Registry" ]] || {
      echo "archive: 拒绝修改非 ohos-sdd registry: $reg" >&2
      return 2
    }
  fi
  if ! run_engine archive-ready "$change" --contract "$contract"; then
    echo "archive: 归档就绪硬门禁未通过，registry 未修改" >&2
    return 1
  fi
  local id; id="$(basename "$change")"
  local codespec_dir="${workspace_root}/.codespec"
  mkdir -p "$codespec_dir"
  if ! grep -Fq -- "- ${id} " "$reg" 2>/dev/null &&
     ! grep -Fq -- "| ${id} |" "$reg" 2>/dev/null; then
    local tmp="${reg}.tmp.$$"
    if [[ -f "$reg" ]]; then
      cp "$reg" "$tmp"
    else
      printf '# Registry\n\n' > "$tmp"
    fi
    printf -- '- %s archived\n' "$id" >> "$tmp"
    mv "$tmp" "$reg"
  fi
  echo "已归档:${id} → ${reg}"
  echo "(长期 specs/ 回灌在 P5/后续 batch 实现)"
}

cmd_spec_for_validation() {
  have_python || { echo "spec-for-validation 需 Python 3.8+" >&2; return 2; }
  local profiles_dir
  profiles_dir="$(resolve_profiles)" || { echo "spec-for-validation: 找不到 Profile 目录" >&2; return 2; }
  run_engine spec-for-validation "$@" --profiles "$profiles_dir"
}

main() {
  local sub="${1:-}"
  [[ $# -ge 1 ]] && shift || true
  case "$sub" in
    status)    cmd_status "$@" ;;
    validate)  cmd_validate "$@" ;;
    approval-digest) cmd_approval_digest "$@" ;;
    archive)   cmd_archive "$@" ;;
    init)      cmd_init "$@" ;;
    registry)  cmd_registry "$@" ;;
    spec-for-validation) cmd_spec_for_validation "$@" ;;
    spec-for-test)
      echo "spec-for-test 已重命名为 spec-for-validation；请迁移旧文件和 Profile 配置后使用新命令" >&2
      exit 2
      ;;
    version|--version) echo "ohos-sdd 0.5.1 (machine-layer skeleton)" ;;
    help|--help|-h)    usage ;;
    "")                usage; exit 0 ;;
    *) echo "unknown subcommand: $sub" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
