{
  "version": "2.0.13",
  "dependencies": [
    "openpyxl>=3.0.0",
    "pandas>=1.3.0"
  ],
  "external_tools": [
    {
      "name": "oh-gc",
      "description": "GitCode CLI，PR模式推荐认证方式",
      "install": "npm install -g @oh-gc-cli",
      "auto_detect": true,
      "fallback": "Token直传或GITCODE_TOKEN环境变量"
    },
    {
      "name": "ripgrep",
      "description": "高性能文本搜索工具，加速正则规则扫描",
      "install": "sudo apt install ripgrep",
      "auto_detect": true,
      "fallback": "回退到Python正则（速度较慢）"
    }
  ],
  "loading_strategy": {
    "builtin_rules": {
      "path": "scripts/scanners/",
      "count": 30,
      "always_load": true
    },
    "cache": {
      "file_content_cache": true,
      "block_cache": true,
      "function_definition_cache": true,
      "max_cached_files": 80000
    }
  },
  "config": {
    "python_version": ">=3.8.0",
    "supported_file_types": [
      ".test.ts", ".test.js", ".test.ets",
      ".cpp", ".c", ".ts", ".ets", ".js",
      "Test.json", "BUILD.gn", ".p7b", "syscap.json", "oh-package.json5"
    ],
    "excluded_dirs": ["node_modules", "dist", "build", ".git", ".idea"],
    "assertion_methods": [
      "assertClose", "assertContain", "assertEqual", "assertFail", "assertFalse", "assertTrue",
      "assertInstanceOf", "assertLarger", "assertLess", "assertLargerOrEqual", "assertLessOrEqual",
      "assertNull", "assertThrowError", "assertUndefined", "assertNaN",
      "assertNegUnlimited", "assertPosUnlimited", "assertDeepEquals"
    ]
  },
  "rules": {
    "critical": [
      "R001", "R002", "R003", "R004", "R006", "R007", "R010", "R011", "R012",
      "R014", "R017", "R018", "R019", "R020", "R021", "R022", "R023",
      "R201", "R202", "R203", "R204", "R205"
    ],
    "warning": ["R005", "R008", "R009", "R013", "R015", "R016", "R206"]
  },
  "rule_categories": {
    "compliance": {
      "name": "编码规范合规",
      "rules": ["R001","R002","R003","R004","R005","R006","R007","R008","R009","R010",
                "R011","R012","R013","R014","R015","R016","R017","R018","R019","R020",
                "R021","R022","R023"],
      "description": "检测代码写没写对、符不符合编码规范（R001-R023）"
    },
    "async_safety": {
      "name": "异步/时序安全",
      "rules": ["R201","R202","R203"],
      "description": "检测异步操作中的done回调缺失、错误处理遗漏、并发时序问题"
    },
    "resource_management": {
      "name": "资源管理",
      "rules": ["R204","R205"],
      "description": "检测资源创建后未释放、生命周期钩子配对缺失"
    },
    "test_design": {
      "name": "测试设计",
      "rules": ["R206"],
      "description": "检测用例间隐式依赖"
    },
    "technical": {
      "name": "测试技术问题",
      "rules": ["R201","R202","R203","R204","R205","R206"],
      "description": "测试技术问题汇总（R201-R206）"
    }
  },
  "rule_descriptions": {
    "critical": {
      "R001": "禁止使用getSync系统接口",
      "R002": "错误码断言必须是number类型",
      "R003": "禁止恒真断言",
      "R004": "测试用例缺少断言",
      "R006": "禁止基于设备类型差异化",
      "R007": "Test.json禁止配置项",
      "R010": "part_name/subsystem_name不匹配",
      "R011": "testsuite重复",
      "R012": "签名证书APL等级和app-feature配置错误",
      "R014": "测试HAP命名不规范",
      "R017": "syscap.json配置多个能力",
      "R018": "testcase重复",
      "R019": ".key重复",
      "R020": ".id重复",
      "R021": "hypium版本号>=1.0.26",
      "R022": "errcode值断言使用宽松比较（==/!=）而非严格比较（===/!==）",
      "R023": "禁止errcode值类型强转后断言",
      "R201": "异步用例缺少done回调或未await（Sta工程额外检测Promise executor声明为async）",
      "R202": "异步回调/Promise未正确处理错误（Sta工程额外检测reject传入非Error类型）",
      "R203": "多异步接口并发调用无隔离导致时序异常",
      "R204": "资源创建后未释放（监听器/连接/对象）",
      "R205": "beforeAll/beforeEach存在但缺少配对的afterAll/afterEach"
    },
    "warning": {
      "R005": "组件尺寸使用固定值",
      "R008": "用例声明格式不规范",
      "R009": "@tc.number命名不规范",
      "R013": "注释的废弃代码",
      "R015": "Level参数缺省",
      "R016": "testcase命名规范",
      "R206": "用例间存在隐式依赖（Sta工程检测EAWorker共享对象，Dyn工程检测全局状态共享）"
    }
  },
  "rule_enforcement": {
    "mandatory": ["R001","R003","R004","R006","R007","R012","R014","R017","R018","R019","R020","R021","R201","R202","R203","R204","R205"],
    "configurable": ["R002","R005","R008","R009","R010","R013","R015","R016","R022","R023","R206"]
  },
  "sta_applicability": {
    "not_applicable": ["R002", "R022"],
    "applicable_universal": [
      "R001", "R003", "R004", "R005", "R006", "R007", "R008", "R009",
      "R010", "R011", "R012", "R013", "R014", "R015", "R016", "R017",
      "R018", "R019", "R020", "R021", "R023",
      "R203", "R204", "R205"
    ],
    "applicable_sta_specialized": ["R201", "R202", "R206"],
    "sta_specialized_notes": {
      "R201": "Sta额外检测async executor声明（已实现）",
      "R202": "Sta额外检测reject传入非Error类型（已实现）",
      "R206": "Sta检测EAWorker共享对象而非globalThis（已实现）"
    },
    "not_applicable_reasons": {
      "R002": "Sta编译器拒绝number vs string类型比较，编译时已拦截",
      "R022": "Sta编译器拒绝==跨类型比较，编译时已拦截；对同类型==与===行为一致"
    }
  },
  "performance": {
    "max_files_per_batch": 1000,
    "enable_parallel_processing": true,
    "cache_enabled": true,
    "progress_report_interval": 300
  },
  "fixable_rules": ["R008", "R011", "R012", "R014", "R016", "R018"],
  "fix_guide_paths": {
    "R008": "guides/R008_testcase_format/R008_FIX_GUIDE.md",
    "R011": "guides/R011_testsuite_duplicate/R011_FIX_GUIDE.md",
    "R012": "guides/R012_p7b_signature/R012_FIX_GUIDE.md",
    "R014": "guides/R014_hap_naming/R014_HAP_NAMING_GUIDE.md",
    "R016": "guides/R016_testcase_naming/R016_FIX_GUIDE.md",
    "R018": "guides/R018_testcase_duplicate/R018_FIX_GUIDE.md"
  }
}